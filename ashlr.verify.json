{
  "schemaVersion": 1,
  "mode": "replace-detected",
  "commands": [
    {
      "id": "phantom-ruby-syntax",
      "kind": "typecheck",
      "cmd": ["ruby", "-c", "Formula/phantom.rb"],
      "cwd": ".",
      "timeoutMs": 180000,
      "required": true,
      "profiles": ["quick", "merge", "deep"]
    },
    {
      "id": "phantom-homebrew-style",
      "kind": "lint",
      "cmd": ["brew", "style", "Formula/phantom.rb"],
      "cwd": ".",
      "timeoutMs": 180000,
      "required": true,
      "profiles": ["quick", "merge", "deep"]
    }
  ]
}
